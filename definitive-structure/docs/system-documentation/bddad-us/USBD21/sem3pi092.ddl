-- ==============================================================
-- 1. CRIAÇÃO DAS TABELAS (CORRIGIDAS)
-- ==============================================================

CREATE TABLE locomotive (
                            id_locomotive number(10) GENERATED BY DEFAULT AS IDENTITY,
                            name varchar2(255) NOT NULL,
                            make varchar2(255) NOT NULL,
                            service number(10) NOT NULL,
                            number_bogies number(10) NOT NULL,
                            bogies varchar2(255) NOT NULL,
                            power number(10) NOT NULL,
                            length number(10) NOT NULL,
                            width number(10) NOT NULL,
                            height number(10) NOT NULL,
                            weight number(10) NOT NULL,
                            max_speed number(10) NOT NULL,
                            operational_speed number(10) NOT NULL,
                            traction number(10) NOT NULL,
                            type varchar2(255) NOT NULL,
                            voltage number(10),
                            frequency number(10),
                            operator varchar2(255) NOT NULL,
                            bitola number(10) NOT NULL,
                            combustivel number(10),
                            PRIMARY KEY (id_locomotive)
);

CREATE TABLE station (
                         id_station number(10) GENERATED BY DEFAULT AS IDENTITY,
                         name_station varchar2(255) NOT NULL,
                         positionx number(10) NOT NULL,
                         positiony number(10) NOT NULL,
                         PRIMARY KEY (id_station)
);

CREATE TABLE owner (
                       id_owner number(10) GENERATED BY DEFAULT AS IDENTITY,
                       short_name varchar2(255) NOT NULL,
                       vatnumber varchar2(255) NOT NULL,
                       PRIMARY KEY (id_owner)
);

CREATE TABLE operator (
                          Id_operator number(10) GENERATED BY DEFAULT AS IDENTITY,
                          short_name_operator varchar2(255) NOT NULL,
                          vatnumber_operator varchar2(255) NOT NULL,
                          PRIMARY KEY (Id_operator)
);

CREATE TABLE facility (
                          id_facility number(10) GENERATED BY DEFAULT AS IDENTITY,
                          name varchar2(255) NOT NULL,
                          PRIMARY KEY (id_facility)
);

CREATE TABLE line (
                      id_line number(10) GENERATED BY DEFAULT AS IDENTITY,
                      name_line varchar2(255) NOT NULL,
                      owner varchar2(255) NOT NULL,
                      gauge number(10) NOT NULL,
                      start_id number(10) NOT NULL,
                      start_name varchar2(255) NOT NULL,
                      end_id number(10) NOT NULL,
                      end_name varchar2(255) NOT NULL,
                      ownerid_owner number(10) NOT NULL,
                      PRIMARY KEY (id_line)
);

CREATE TABLE segment (
                         id_segment number(10) GENERATED BY DEFAULT AS IDENTITY,
                         line_id number(10) NOT NULL,
                         "order" number(10) NOT NULL,
                         eletrified raw(2000) NOT NULL,
                         weight number(10) NOT NULL,
                         length number(10) NOT NULL,
                         number_tracks varchar2(255) NOT NULL,
                         siding_position number(10) NOT NULL,
                         siding_lenght number(10) NOT NULL,
                         PRIMARY KEY (id_segment)
);

CREATE TABLE locomotive_operator (
                                     operator_id number(10) NOT NULL,
                                     locomotive_id number(10) NOT NULL,
                                     short_name_operator number(10) NOT NULL,
                                     PRIMARY KEY (operator_id, locomotive_id)
);

CREATE TABLE wagon_model (
                             id_model number(10) GENERATED BY DEFAULT AS IDENTITY,
                             model_wagon varchar2(255) NOT NULL,
                             maker varchar2(255) NOT NULL,
                             number_bogies number(10) NOT NULL,
                             bogies varchar2(255) NOT NULL,
                             lenght number(10) NOT NULL,
                             width number(10) NOT NULL,
                             height number(10) NOT NULL,
                             weight number(10) NOT NULL,
                             max_speed number(10) NOT NULL,
                             payload number(10) NOT NULL,
                             volume number(10) NOT NULL,
                             type varchar2(255) NOT NULL,
                             bitola number(10) NOT NULL,
                             PRIMARY KEY (id_model)
);

CREATE TABLE wagon (
                       "number" number(10) GENERATED BY DEFAULT AS IDENTITY,
                       model varchar2(255) NOT NULL,
                       operator varchar2(255) NOT NULL,
                       service_year number(10) NOT NULL,
                       model_id number(10) NOT NULL,
                       Operator_id number(10) NOT NULL,
                       PRIMARY KEY ("number")
);

CREATE TABLE building_type (
                               id_building_type number(10) GENERATED BY DEFAULT AS IDENTITY,
                               type varchar2(255) NOT NULL,
                               PRIMARY KEY (id_building_type)
);

CREATE TABLE Building (
                          id_building number(10) GENERATED BY DEFAULT AS IDENTITY,
                          facility_id number(10) NOT NULL,
                          name varchar2(255) NOT NULL,
                          building_type_id number(10) NOT NULL,
                          PRIMARY KEY (id_building)
);

CREATE TABLE Gauge (
                       id_gauge number(10) GENERATED BY DEFAULT AS IDENTITY,
                       width number(10) NOT NULL,
                       PRIMARY KEY (id_gauge)
);

CREATE TABLE locomotive_Gauge (
                                  locomotive_id number(10) NOT NULL,
                                  Gauge_id number(10) NOT NULL,
                                  PRIMARY KEY (locomotive_id, Gauge_id)
);

CREATE TABLE Gauge_line (
                            gauge_id number(10) NOT NULL,
                            line_id number(10) NOT NULL,
                            PRIMARY KEY (gauge_id, line_id)
);

CREATE TABLE wagon_Gauge (
                             wagonnumber number(10) NOT NULL,
                             Gaugeid_gauge number(10) NOT NULL,
                             PRIMARY KEY (wagonnumber, Gaugeid_gauge)
);

CREATE TABLE train (
                       id_train number(10) GENERATED BY DEFAULT AS IDENTITY,
                       operator number(10) NOT NULL,
                       time timestamp(0) NOT NULL,
                       "date" date NOT NULL,
                       start_id number(10) NOT NULL,
                       end_id number(10) NOT NULL,
                       freight varchar2(255) NOT NULL,
                       locomotive varchar2(255) NOT NULL,
                       path varchar2(255) NOT NULL,
                       operator_id number(10) NOT NULL,
                       PRIMARY KEY (id_train)
);

CREATE TABLE train_composition (
                                   id_train_composition number(10) NOT NULL,
                                   trainid_train number(10) NOT NULL,
                                   wagonnumber number(10) NOT NULL,
                                   position_in_train number(10) NOT NULL,
                                   loaded raw(1000) NOT NULL,
                                   load_weight number(10) NOT NULL,
                                   PRIMARY KEY (id_train_composition, trainid_train, wagonnumber)
);

CREATE TABLE freights (
                          id_freights number(10) GENERATED BY DEFAULT AS IDENTITY,
                          "date" date NOT NULL,
                          origin number(10) NOT NULL,
                          facility number(10) NOT NULL,
                          destination number(10) NOT NULL,
                          facility_final number(10) NOT NULL,
                          wagon varchar2(4000) NOT NULL, -- Alterado de DATE para VARCHAR2 para aceitar texto
                          PRIMARY KEY (id_freights)
);

ALTER TABLE locomotive_operator ADD CONSTRAINT FKlocomotive506643 FOREIGN KEY (locomotive_id) REFERENCES locomotive (id_locomotive);
ALTER TABLE locomotive_operator ADD CONSTRAINT FKlocomotive16944 FOREIGN KEY (operator_id) REFERENCES operator (Id_operator);
