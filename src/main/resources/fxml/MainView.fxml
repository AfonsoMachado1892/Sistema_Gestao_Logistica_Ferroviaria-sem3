<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LAPR3.UI.javafx.MainController">
   <top>
      <VBox styleClass="header-container">
         <HBox styleClass="header-box">
            <Text styleClass="header-title" text="Railway Network Logistics Management" />
            <Region HBox.hgrow="ALWAYS" />
            <Text styleClass="header-subtitle" text="Operational Management System" />
         </HBox>
      </VBox>
   </top>
   <center>
      <TabPane fx:id="mainTabPane" styleClass="main-tab-pane" tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <Tab fx:id="freightAssignmentTab" text="Freight Assignment" closable="false" />
            <Tab fx:id="trainAssemblyTab" text="Train Assembly" closable="false" />
            <Tab fx:id="trafficManagerTab" text="Traffic Manager" closable="false" />
         </tabs>
      </TabPane>
   </center>
</BorderPane>

